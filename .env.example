# DB
DATABASE_URL=postgresql://axmark@localhost/axmark

# 인증 모드: oidc(운영, 사내 SSO) | dev(로컬 개발용 – 사번 선택 로그인, 운영 금지)
AUTH_MODE=oidc

# 세션 쿠키 서명 키 – 충분히 긴 임의 문자열 (예: python -c "import secrets; print(secrets.token_urlsafe(48))")
SESSION_SECRET=
SESSION_MAX_AGE=28800          # 초 단위, 기본 8시간
SESSION_HTTPS_ONLY=true        # 운영은 반드시 HTTPS

# 사내 SSO (OpenID Connect) – IdP 에 앱을 등록한 뒤 발급값 입력
#   Entra ID : https://login.microsoftonline.com/<tenant-id>/v2.0
#   Google   : https://accounts.google.com
#   Okta     : https://<org>.okta.com
#   Keycloak : https://<host>/realms/<realm>
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# IdP 에 등록한 Redirect URI 와 동일하게 (리버스 프록시 뒤에서는 명시 권장)
OIDC_REDIRECT_URI=https://axmark.example.com/auth/callback
OIDC_SCOPE=openid email profile

# SSO 사용자 → 직원 매핑: ID 토큰 클레임 ↔ employee 컬럼
OIDC_USER_CLAIM=email          # Entra ID 에서 email 클레임이 없으면 preferred_username 사용
OIDC_MATCH_COLUMN=email        # email | emp_no
