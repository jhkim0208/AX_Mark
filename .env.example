# DB
DATABASE_URL=postgresql://axmark@localhost/axmark

# 세션 쿠키 서명 키 – 반드시 설정 (미설정 시 서버 재시작마다 전원 로그아웃)
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
SESSION_MAX_AGE=28800          # 초 단위, 기본 8시간
SESSION_HTTPS_ONLY=true        # 운영은 반드시 HTTPS. 로컬 http 테스트 시에만 false
